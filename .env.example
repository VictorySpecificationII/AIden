# AIden environment configuration.
# Copy to .env (gitignored) and adjust:  cp .env.example .env && chmod 600 .env
# Docker Compose loads .env automatically for ${VAR} substitution.
#
# NOTE: the credential values below are the platform's existing dev defaults,
# kept so nothing breaks. Replace them with generated values in a later pass.

# --- Hardware profile ---
# bootstrap/detect-profiles.sh detects this machine's accelerators and sets
# COMPOSE_PROFILES, the OpenWebUI backend URLs, RENDER_GID and DOCKER_GID below.
# Set to manual to keep your own values (the script then only reports).
AIDEN_PROFILES_MODE=auto

# Pick one of nvidia/cpu, optionally plus npu and/or intel-gpu (e.g. cpu,npu,intel-gpu):
# nvidia: Ollama on the NVIDIA GPU + DCGM exporter (needs NVIDIA Container Toolkit)
# cpu:    Ollama on CPU, no NVIDIA services
# npu:       adds OVMS serving a small LLM on the Intel NPU (classifier and fallback)
# intel-gpu: adds OVMS serving a mid-size LLM on an Intel GPU (Arc / iGPU)
COMPOSE_PROFILES=nvidia

# GID of the host's docker group, so Prometheus can discover exporters via the
# Docker socket:  getent group docker | cut -d: -f3
DOCKER_GID=999

# --- Observability ---
ELASTIC_PASSWORD=changeme
GF_SECURITY_ADMIN_PASSWORD=grafana

# GID of the group that may read the host journal (AIden's read-only gear check):
#   getent group systemd-journal | cut -d: -f3
JOURNAL_GID=999

# --- Intel profiles (npu, intel-gpu) ---
# GID of the render group owning /dev/accel/accel0 and /dev/dri/renderD*:  stat -c %g /dev/dri/renderD128
RENDER_GID=993

# --- AIden ---
# Show which model answered (and any tier that was unavailable) under each reply
AIDEN_SHOW_ROUTE=true
# Record each request (prompt, routing decision, answer) as training data for AIden's
# own model; stays in the local aiden-experience volume. Note text is never recorded.
AIDEN_RECORD_EXPERIENCE=true

# --- Mentor (profile mentor: Claude via the Claude Code CLI, tools/mentor-bridge) ---
# Long-lived Claude subscription token: run `claude setup-token` in your own terminal
# and paste the result here (never commit it). Revoke it from your Claude account.
CLAUDE_CODE_OAUTH_TOKEN=
# Shared secret between AIden and the bridge: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MENTOR_TOKEN=
MENTOR_MAX_PER_HOUR=10
# Optional: a smaller model to save your Claude Code limits, e.g. a Sonnet or Haiku model id
MENTOR_MODEL=

# --- Model steward (AIden choosing their own models; see tools/model-steward) ---
# Shared secret between AIden and the steward: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
STEWARD_TOKEN=
# Disk for candidate models (all but the active and previous ones), and memory that must
# stay free while a candidate is on trial
AIDEN_MODEL_DISK_CAP_GB=20
AIDEN_MODEL_MIN_FREE_GB=4

# --- Vault (AIden's memory) ---
# Absolute path to your Obsidian vault; mounted read-only and indexed for search.
# Quote it if it contains spaces.
VAULT_PATH="/path/to/your/obsidian/vault"

# Embeddings for vault search and indexing (CPU, always on). Multilingual (the vault
# has non-English notes).
OVMS_EMBED_MODEL=OpenVINO/Qwen3-Embedding-0.6B-int8-ov
OVMS_EMBED_MODEL_NAME=qwen3-embedding-0.6b

# intel-gpu: any OpenVINO LLM; see huggingface.co/collections/OpenVINO/llm
OVMS_GPU_MODEL=OpenVINO/Qwen3-8B-int4-ov
OVMS_GPU_MODEL_NAME=qwen3-8b-gpu

# NPU-compatible model (INT4, symmetric channel-wise); see huggingface.co/collections/OpenVINO/llms-optimized-for-npu
OVMS_NPU_MODEL=OpenVINO/Phi-3.5-mini-instruct-int4-cw-ov
OVMS_NPU_MODEL_NAME=phi-3.5-mini-npu

# --- OpenWebUI ---
WEBUI_SECRET_KEY=t0p-s3cr3t
# OpenAI-compatible backends, ";"-separated, with one key per URL. Always list AIden
# (http://aiden:8000/v1); detect-profiles.sh adds the OVMS tiers for this machine.
# npu:       http://ovms-npu:8001/v3     intel-gpu: http://ovms-gpu:8002/v3
# Keys can be any non-empty value (OVMS ignores them), e.g. with both profiles:
#   OPENWEBUI_OPENAI_API_BASE_URLS=http://aiden:8000/v1;http://ovms-npu:8001/v3;http://ovms-gpu:8002/v3
#   OPENWEBUI_OPENAI_API_KEYS=unused;unused;unused
OPENWEBUI_OPENAI_API_BASE_URLS=http://aiden:8000/v1
OPENWEBUI_OPENAI_API_KEYS=unused
# Model OpenWebUI uses for background tasks (titles, tags, follow-ups) while you chat
# with AIden. detect-profiles.sh sets it: the NPU model if there is one, else the Intel
# GPU model, else empty (AIden handles them). Any model id OpenWebUI lists works,
# including an Ollama model you've pulled.
OPENWEBUI_TASK_MODEL=
# AIden reads your 👍/👎 ratings as training feedback. Nothing to set while OpenWebUI
# runs without login (AIden signs in as its built-in admin). If you turn login on, set
# ENABLE_API_KEYS=True on OpenWebUI, create a key (Settings > Account) and paste it here.
OPENWEBUI_API_KEY=

# --- PostgreSQL (MLflow backend store) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- MinIO (S3 artifact storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# MinIO service account used by MLflow for artifacts (created by minio_init)
MLFLOW_S3_ACCESS_KEY=definitelyinsecure
MLFLOW_S3_SECRET_KEY=notsosecretisitnow

# --- Host-side tooling (src/iris/training.py) ---
MLFLOW_TRACKING_URI=http://localhost:5000
S3_ENDPOINT_URL=http://localhost:9000
# Absolute path where llama.cpp is cloned for GGUF conversion
LLAMACPP_DIR=/path/to/AIden/tools/mlops/llama.cpp
