        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(rest_responses_total{endpoint=~\".*/points/search\"}[$__rate_interval])) * 60",
          "legendFormat": "Qdrant searches",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(ovms_requests_accepted{job=\"ovms-cpu-embed\"}[$__rate_interval])) * 60",
          "legendFormat": "texts embedded",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
