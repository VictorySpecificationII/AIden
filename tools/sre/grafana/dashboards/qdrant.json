    {
      "type": "timeseries",
      "title": "Retrieval latency (AIden: embed + search)",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "From the question to the matching notes, as AIden measures it. Includes embedding the question on the CPU.",
