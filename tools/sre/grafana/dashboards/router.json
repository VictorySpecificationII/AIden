      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (backend) (rate(aiden_answer_tokens_per_second_sum[15m])) / sum by (backend) (rate(aiden_answer_tokens_per_second_count[15m]))",
          "legendFormat": "{{backend}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "axisLabel": "tokens/s"
          }
